{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null; then git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ../../CHANGELOG.md; else git diff --quiet HEAD^ HEAD -- . ../../CHANGELOG.md; fi",
  "rewrites": [
    {
      "source": "/api/precos/material/",
      "destination": "https://dadosabertos.compras.gov.br/modulo-pesquisa-preco/1_consultarMaterial"
    },
    {
      "source": "/api/precos/material",
      "destination": "https://dadosabertos.compras.gov.br/modulo-pesquisa-preco/1_consultarMaterial"
    },
    {
      "source": "/api/precos/servico/",
      "destination": "https://dadosabertos.compras.gov.br/modulo-pesquisa-preco/3_consultarServico"
    },
    {
      "source": "/api/precos/servico",
      "destination": "https://dadosabertos.compras.gov.br/modulo-pesquisa-preco/3_consultarServico"
    },
    {
      "source": "/api/siconfi/dca/",
      "destination": "https://apidatalake.tesouro.gov.br/ords/siconfi/tt/dca"
    },
    {
      "source": "/api/siconfi/dca",
      "destination": "https://apidatalake.tesouro.gov.br/ords/siconfi/tt/dca"
    }
  ]
}
