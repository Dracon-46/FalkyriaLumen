flowchart TB
    classDef pessoa fill:#1F3864,stroke:#0d1b33,color:#ffffff
    classDef externo fill:#8497B0,stroke:#44546A,color:#ffffff
    classDef nucleo fill:#C00000,stroke:#7f0000,color:#ffffff
    classDef grp fill:#F7F9FC,stroke:#B4C6E7,color:#1F3864

    subgraph ATORES["Quem usa"]
        direction LR
        CID["Cidadao<br/>controle social"]:::pessoa
        JOR["Jornalista<br/>de dados"]:::pessoa
        PES["Pesquisador"]:::pessoa
        ORG["Orgaos de controle<br/>TCU, TCE, CGU, MP"]:::pessoa
        ENTE["Ente analisado<br/>direito de resposta"]:::pessoa
    end

    LUMEN["SISTEMA LUMEN<br/>Coleta, normaliza e analisa contratacoes<br/>e despesas publicas do Brasil.<br/>Emite indicios para analise, nunca acusacoes."]:::nucleo

    subgraph FED["Fontes federais obrigatorias"]
        direction LR
        PNCP["PNCP<br/>contratacoes, contratos,<br/>amparo legal"]:::externo
        SIC["SICONFI<br/>RREO, RGF, DCA<br/>de estados e municipios"]:::externo
        PT["Portal da Transparencia<br/>despesas, convenios,<br/>CEIS CNEP CEPIM"]:::externo
    end

    subgraph COMP["Fontes complementares"]
        direction LR
        RFB["Receita Federal<br/>CNPJ e quadro societario"]:::externo
        IBGE["IBGE<br/>populacao e territorio"]:::externo
        TC["TCU e 27 TCE/TCM<br/>acordaos"]:::externo
        MUN["Portais estaduais<br/>e municipais<br/>API, HTML, PDF, XLS"]:::externo
    end

    ATORES --> LUMEN
    FED --> LUMEN
    COMP --> LUMEN

    class ATORES,FED,COMP grp
