    subgraph P["Portal (Vercel)"]
        P1["/contratacoes/<br/>Brasil, ente, órgão"]:::web
        P2["/conformidade/<br/>Brasil, UF, ente"]:::web
    end

    F1 --> G1
    F2 --> G2
    F2 --> G3
    G1 -- "gh release upload" --> E
    G2 --> E
