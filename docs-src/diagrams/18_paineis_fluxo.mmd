    classDef proc fill:#2E75B6,stroke:#1f4e79,color:#ffffff
    classDef estado fill:#A0522D,stroke:#5c2f18,color:#ffffff
    classDef feed fill:#548235,stroke:#375623,color:#ffffff
    classDef web fill:#7F7F7F,stroke:#404040,color:#ffffff
    classDef grp fill:#FAFAFA,stroke:#BFBFBF,color:#404040

    subgraph F["Fontes oficiais"]
        F1["PNCP<br/>contratações (19 modalidades)<br/>e contratos, por dia de publicação"]:::fonte
        F2["SICONFI<br/>cadastro de entes (/entes)<br/>e extrato de entregas por ente"]:::fonte
    end

    subgraph G["GitHub Actions (paineis, paineis-carga)"]
        G1["lumen painel contratacoes<br/>um dia por vez: bronze e silver<br/>temporários, dia só se completo"]:::proc
        G2["lumen painel conformidade<br/>extrato por UF, exercício<br/>anterior e corrente"]:::proc
